# Hermes Foundation — переменные окружения
# Скопируй в .env и заполни реальными ключами

# LLM (для Claude-агента анализа)
ANTHROPIC_API_KEY=sk-ant-...

# Биржа (Bybit)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram бот (для уведомлений/сигналов)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100...
